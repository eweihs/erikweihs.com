{
  "name": "erik-weihs-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "playwright test --project=integration",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm run lint:unused && npm run format:check && npm run test:integration",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eweihs/engineering-standards": "github:eweihs/engineering-standards#v3.1.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.3"
  }
}
